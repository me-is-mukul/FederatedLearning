    {
        "id": "mqtt_mode",
        "type": "function",
        "z": "tab_sim",
        "name": "Change meter mode",
        "func": "const meter = msg.topic.split(\"/\").pop();\nconst mode = typeof msg.payload === \"string\" ? msg.payload : (msg.payload && msg.payload.mode) || \"normal\";\nconst allowed = [\"normal\", \"stuck\", \"spike\", \"reverse\", \"ev\", \"solar\"];\nif (!allowed.includes(mode)) return null;\nconst modes = global.get(\"modes\") || {};\n(meter === \"all\" ? [\"MTR-00\", \"MTR-01\", \"MTR-02\", \"MTR-03\", \"MTR-04\"] : [meter]).forEach(id => { modes[id] = mode; });\nglobal.set(\"modes\", modes);\nnode.status({fill: \"blue\", shape: \"dot\", text: meter + \" -> \" + mode});\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 300,
        "wires": [
            []
        ]
