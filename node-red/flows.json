    {
        "id": "simulate",
        "type": "function",
        "z": "tab_sim",
        "name": "Simulate 5 meters",
        "func": "const METERS = [\"MTR-00\", \"MTR-01\", \"MTR-02\", \"MTR-03\", \"MTR-04\"];\nlet clock = context.get(\"clock\") || 0;\nlet session = context.get(\"session\");\nif (!session) { session = new Date().toISOString(); context.set(\"session\", session); }\nlet start = context.get(\"start\");\nif (!start) {\n    const today = new Date();\n    start = Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate());\n    context.set(\"start\", start);\n}\nlet homes = context.get(\"homes\");\nif (!homes) {\n    homes = METERS.map((id, i) => ({\n        standby: 50 + 25 * i,\n        evening: 120 + 40 * i,\n        morning: 60 + 20 * i,\n        fridgePower: 85 + 10 * i,\n        fridgeOn: false,\n        fridgeLeft: 5 + 7 * i,\n        kettleLeft: 0,\n        washerLeft: 0,\n        held: null\n    }));\n}\nconst modes = global.get(\"modes\") || {};\nconst minute = clock % 1440;\nconst time = new Date(start + clock * 60000);\nconst messages = [];\nhomes.forEach((h, i) => {\n    const id = METERS[i];\n    let p = h.standby * (1 + 0.05 * Math.sin(2 * Math.PI * minute / 1440));\n    if (minute > 1050 && minute < 1380) p += h.evening;\n    if (minute > 390 && minute < 510) p += h.morning;\n    h.fridgeLeft -= 1;\n    if (h.fridgeLeft <= 0) {\n        h.fridgeOn = !h.fridgeOn;\n        h.fridgeLeft = h.fridgeOn ? 15 + Math.random() * 7 : 30 + Math.random() * 15;\n    }\n    if (h.fridgeOn) p += h.fridgePower;\n    const kettleTime = (minute >= 380 && minute < 540) || (minute >= 960 && minute < 1320);\n    if (h.kettleLeft > 0) { p += 2500; h.kettleLeft -= 1; }\n    else if (kettleTime && Math.random() < 0.012) h.kettleLeft = 3;\n    if (h.washerLeft > 0) { p += h.washerLeft > 50 ? 2000 : (h.washerLeft > 10 ? 220 : 500); h.washerLeft -= 1; }\n    else if (minute >= 480 && minute < 1200 && Math.random() < 0.0008) h.washerLeft = 65;\n    p += (Math.random() - 0.5) * 4;\n    const mode = modes[id] || \"normal\";\n    if (mode === \"ev\" && minute >= 1140 && minute < 1380) p += 7000;\n    if (mode === \"solar\") p -= 3000 * Math.max(0, Math.sin(Math.PI * (minute - 390) / 720));\n    if (mode === \"spike\" && Math.random() < 0.05) p += 5000 + Math.random() * 10000;\n    if (mode === \"reverse\") p = -p;\n    if (mode === \"stuck\") { if (h.held === null) h.held = p; p = h.held; } else h.held = null;\n    messages.push({\n        topic: \"gridguard/meters/\" + id + \"/reading\",\n        payload: {\n            meter_id: id,\n            household_id: \"house-\" + id.slice(4),\n            session: session,\n            ts: time.toISOString(),\n            power_w: Math.round(p * 10) / 10,\n            voltage_v: Math.round((230 + (Math.random() - 0.5) * 4) * 10) / 10\n        }\n    });\n});\ncontext.set(\"homes\", homes);\ncontext.set(\"clock\", clock + 1);\nglobal.set(\"simTime\", time.toISOString().slice(0, 16).replace(\"T\", \" \"));\nnode.status({fill: \"green\", shape: \"dot\", text: \"meter time \" + time.toISOString().slice(11, 16)});\nreturn [messages];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 220,
        "wires": [
            [
                "publish_reading"
            ]
        ]
