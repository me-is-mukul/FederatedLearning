        "z": "tab_cloud",
        "name": "Check response",
        "func": "const entry = parseInt(msg.payload, 10);\nif (msg.statusCode === 200 && entry > 0) {\n    node.status({fill: \"green\", shape: \"dot\", text: \"sent entry \" + entry + \", total \" + msg.fields.field6 + \" W\"});\n    return null;\n}\nnode.status({fill: \"red\", shape: \"ring\", text: \"ThingSpeak refused (\" + msg.statusCode + \" / \" + msg.payload + \")\"});\nreturn {payload: {status: msg.statusCode, response: msg.payload}};\n",
