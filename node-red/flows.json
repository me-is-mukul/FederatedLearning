    "id": "control_in",
    "type": "http in",
    "z": "tab",
    "name": "POST /control",
    "url": "/control",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 280,
    "wires": [
      [
        "control"
      ]
    ]
  },
  {
    "id": "control",
    "type": "function",
    "z": "tab",
    "name": "Check command",
    "func": "const body = msg.payload || {};\nconst modes = [null, \"stuck\", \"spike\", \"reverse\", \"ev\", \"solar\"];\nconst mode = body.mode === undefined ? null : body.mode;\nif (!/^(MTR-\\d{2}|all)$/.test(body.meter_id || \"\") || !modes.includes(mode)) {\n    msg.statusCode = 400;\n    msg.payload = {error: \"send meter_id (MTR-00 or all) and mode: null, stuck, spike, reverse, ev or solar\"};\n    return [null, msg];\n}\nconst command = {topic: \"gridguard/control/\" + body.meter_id, payload: {mode: mode}};\nmsg.statusCode = 202;\nmsg.payload = {sent: command.payload, to: command.topic};\nreturn [command, msg];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 280,
    "wires": [
      [
        "control_out"
      ],
      [
        "control_reply"
      ]
    ]
  },
