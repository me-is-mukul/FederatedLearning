    {
        "id": "readings_in",
        "type": "mqtt in",
        "z": "tab_ingest",
        "name": "Meter readings",
        "topic": "gridguard/meters/+/reading",
        "qos": "0",
        "datatype": "json",
        "broker": "broker",
        "nl": false,
        "rap": true,
