    {
        "id": "check",
        "type": "function",
        "z": "tab_ingest",
        "name": "Check reading",
        "func": "const r = msg.payload;\nif (!r || !r.meter_id || !r.ts || typeof r.power_w !== \"number\") {\n    node.status({fill: \"red\", shape: \"ring\", text: \"bad reading dropped\"});\n    return null;\n}\nconst s = context.get(r.meter_id) || {before: null, pending: null, repeats: 0};\nconst p = s.pending;\ns.pending = r;\nif (!p) {\n    context.set(r.meter_id, s);\n    return null;\n}\nconst flags = [];\nif (s.before !== null && p.power_w === s.before) s.repeats += 1; else s.repeats = 0;\nif (s.repeats >= 9) flags.push(\"stuck\");\nif (s.before !== null && p.power_w - Math.max(s.before, r.power_w) > 4000) flags.push(\"spike\");\nif (p.power_w < -20 && new Date(p.ts).getUTCHours() < 4) flags.push(\"reverse\");\nif (Math.abs(p.power_w) > 23000) flags.push(\"implausible\");\ns.before = p.power_w;\ncontext.set(r.meter_id, s);\np.flags = flags;\np.received_at = new Date().toISOString();\nconst alert = flags.length ? {payload: {meter_id: p.meter_id, session: p.session, ts: p.ts, problem: flags.join(\", \"), power_w: p.power_w}} : null;\nreturn [{payload: p}, alert];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 310,
        "y": 160,
        "wires": [
            [
                "save_reading",
                "diagnose",
                "to_cloud",
                "to_ui"
            ],
            [
                "save_alert",
                "publish_alert",
                "to_ui_alert"
            ]
        ]
    },
    {
        "id": "save_reading",
        "type": "mongodb4",
        "z": "tab_ingest",
        "clientNode": "mongo_client",
        "mode": "collection",
        "collection": "readings",
        "operation": "insertOne",
        "output": "toArray",
        "maxTimeMS": "0",
        "handleDocId": false,
        "name": "Save reading",
        "x": 580,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "diagnose",
        "type": "function",
        "z": "tab_ingest",
        "name": "Hourly diagnosis",
        "func": "const r = msg.payload;\nconst buffers = context.get(\"buffers\") || {};\nconst b = buffers[r.meter_id] || [];\nb.push(r);\nif (b.length < 60) {\n    buffers[r.meter_id] = b;\n    context.set(\"buffers\", buffers);\n    return null;\n}\nbuffers[r.meter_id] = [];\ncontext.set(\"buffers\", buffers);\nconst power = b.map(x => x.power_w);\nconst hour = new Date(b[0].ts).getUTCHours();\nconst sunUp = hour >= 6 && hour < 19;\nconst negative = power.filter(p => p < -20).length / power.length;\nconst flat = b.filter(x => x.flags.includes(\"stuck\")).length / b.length;\nconst spikes = b.filter(x => x.flags.includes(\"spike\")).length;\nconst heavy = power.filter(p => p > 5000).length;\nconst reversed = global.get(\"reversedMeters\") || {};\nif (!sunUp) reversed[r.meter_id] = negative > 0.5;\nglobal.set(\"reversedMeters\", reversed);\nlet diagnosis = \"normal\";\nlet reason = \"nothing unusual\";\nif (flat > 0.15) { diagnosis = \"meter fault\"; reason = \"reading frozen\"; }\nelse if (spikes >= 1) { diagnosis = \"meter fault\"; reason = spikes + \" impossible spikes\"; }\nelse if (negative > 0.5 && !sunUp) { diagnosis = \"meter fault\"; reason = \"negative power with no sun (wired backwards)\"; }\nelse if (negative > 0.2 && reversed[r.meter_id]) { diagnosis = \"meter fault\"; reason = \"negative day and night (wired backwards)\"; }\nelse if (negative > 0.2) { diagnosis = \"genuine change\"; reason = \"exporting in daylight (solar panels?)\"; }\nelse if (heavy >= 30) { diagnosis = \"genuine change\"; reason = heavy + \" minutes above 5 kW (EV charging?)\"; }\nconst avg = power.reduce((a, p) => a + p, 0) / power.length;\nconst doc = {\n    meter_id: r.meter_id,\n    session: r.session,\n    hour_start: b[0].ts,\n    avg_w: Math.round(avg),\n    max_w: Math.round(Math.max(...power)),\n    min_w: Math.round(Math.min(...power)),\n    energy_kwh: Math.round(avg / 1000 * 1000) / 1000,\n    frozen_share: Math.round(flat * 100) / 100,\n    spikes: spikes,\n    negative_share: Math.round(negative * 100) / 100,\n    heavy_minutes: heavy,\n    diagnosis: diagnosis,\n    reason: reason\n};\nconst latest = global.get(\"diagnosis\") || {};\nlatest[r.meter_id] = doc;\nglobal.set(\"diagnosis\", latest);\nnode.status({fill: diagnosis === \"normal\" ? \"green\" : (diagnosis === \"meter fault\" ? \"red\" : \"yellow\"), shape: \"dot\", text: r.meter_id + \": \" + diagnosis});\nreturn {payload: doc};\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
