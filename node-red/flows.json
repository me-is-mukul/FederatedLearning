    {
        "id": "collect",
        "type": "function",
        "z": "tab_cloud",
        "name": "Collect 20 s window",
        "func": "const r = msg.payload;\nconst window = flow.get(\"window\") || {sum: {}, count: {}, alerts: 0, flagged: {}};\nwindow.sum[r.meter_id] = (window.sum[r.meter_id] || 0) + r.power_w;\nwindow.count[r.meter_id] = (window.count[r.meter_id] || 0) + 1;\nif (r.flags.length) { window.alerts += 1; window.flagged[r.meter_id] = true; }\nflow.set(\"window\", window);\nreturn null;\n",
