  {
    "id": "readings_in",
    "type": "mqtt in",
    "z": "tab",
    "name": "Meter readings",
    "topic": "gridguard/meters/+/reading",
    "qos": "0",
    "datatype": "json",
    "broker": "broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 100,
    "wires": [
      [
        "check"
      ]
    ]
  },
  {
    "id": "check",
    "type": "function",
    "z": "tab",
    "name": "Check reading",
    "func": "const r = msg.payload;\nif (!r || !r.meter_id || !r.household_id || !r.ts || typeof r.power_w !== \"number\") {\n    node.status({fill: \"red\", shape: \"ring\", text: \"bad reading\"});\n    return null;\n}\nconst state = context.get(r.meter_id) || {last: null, repeats: 0, prev: null};\nconst hour = new Date(r.ts).getUTCHours();\nconst flags = [];\nif (state.last === r.power_w) state.repeats += 1; else state.repeats = 0;\nif (state.repeats >= 9) flags.push(\"stuck\");\nif (state.last !== null && state.prev !== null && state.last - Math.max(state.prev, r.power_w) > 4000) flags.push(\"spike\");\nif (r.power_w < -20 && hour < 4) flags.push(\"reverse\");\nif (Math.abs(r.power_w) > 23000) flags.push(\"implausible\");\nstate.prev = state.last;\nstate.last = r.power_w;\ncontext.set(r.meter_id, state);\nr.flags = flags;\nr.received_at = new Date().toISOString();\nnode.status({fill: flags.length ? \"yellow\" : \"green\", shape: \"dot\", text: r.meter_id + \" \" + r.power_w + \" W\"});\nconst reading = {payload: r};\nconst alert = flags.length ? {topic: \"gridguard/alerts/\" + r.meter_id, payload: {meter_id: r.meter_id, household_id: r.household_id, ts: r.ts, flags: flags, power_w: r.power_w}} : null;\nreturn [reading, alert];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 100,
    "wires": [
      [
        "save_reading"
      ],
      [
        "save_alert",
        "alert_out",
        "alert_debug"
      ]
    ]
  },
