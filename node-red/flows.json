    {
        "id": "build_ts",
        "type": "function",
        "z": "tab_cloud",
        "name": "Build ThingSpeak update",
        "func": "const METERS = [\"MTR-00\", \"MTR-01\", \"MTR-02\", \"MTR-03\", \"MTR-04\"];\nconst key = env.get(\"THINGSPEAK_WRITE_KEY\");\nconst w = flow.get(\"window\") || {sum: {}, count: {}, alerts: 0, flagged: {}};\nflow.set(\"window\", {sum: {}, count: {}, alerts: 0, flagged: {}});\nif (!key) {\n    node.status({fill: \"grey\", shape: \"ring\", text: \"no THINGSPEAK_WRITE_KEY set\"});\n    return null;\n}\nif (Object.keys(w.count).length === 0) return null;\nconst fields = {};\nlet total = 0;\nMETERS.forEach((id, i) => {\n    const avg = w.count[id] ? w.sum[id] / w.count[id] : 0;\n    fields[\"field\" + (i + 1)] = Math.round(avg);\n    total += avg;\n});\nfields.field6 = Math.round(total);\nfields.field7 = w.alerts;\nfields.field8 = Object.keys(w.flagged).length;\nconst query = Object.entries(fields).map(([k, v]) => k + \"=\" + v).join(\"&\");\nmsg.url = \"https://api.thingspeak.com/update?api_key=\" + encodeURIComponent(key) + \"&\" + query;\nmsg.fields = fields;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 280,
        "wires": [
            [
                "ts_request"
            ]
        ]
    },
