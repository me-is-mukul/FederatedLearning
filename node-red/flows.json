        "func": "const meter = flow.get(\"selectedMeter\") || \"MTR-00\";\nconst modes = global.get(\"modes\") || {};\nconst targets = meter === \"all\" ? [\"MTR-00\", \"MTR-01\", \"MTR-02\", \"MTR-03\", \"MTR-04\"] : [meter];\ntargets.forEach(id => { modes[id] = msg.payload; });\nglobal.set(\"modes\", modes);\nnode.status({fill: \"blue\", shape: \"dot\", text: meter + \" -> \" + msg.payload});\nreturn {payload: meter + \" is now: \" + msg.payload};\n",
